# คัดลอกไปเป็น .env ที่ root โปรเจกต์บนเซิร์ฟเวอร์
# cp deploy/env.example .env

NODE_ENV=production
PORT=3000

# SQLite — เก็บไฟล์ DB ใน prisma/ (ต้อง backup เป็นประจำ)
DATABASE_URL="file:./prisma/dev.db"

# สุ่มค่ายาวๆ อย่างน้อย 32 ตัว (ห้ามใช้ค่า default)
ADMIN_JWT_SECRET="change-me-to-a-long-random-secret"
